---
import { TEXT, type Lang } from '../config';
interface Props { lang: Lang }
const t = TEXT[Astro.props.lang].trust;
---
<section class="pt-20 sm:pt-28" aria-labelledby="trust-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 rounded-3xl border border-ink/10 bg-white/60 p-7 sm:flex-row sm:items-center sm:gap-10 sm:p-10" data-reveal>
      <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-sand-200 text-jungle">
        <svg viewBox="0 0 24 24" class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z" stroke-linejoin="round" />
          <rect x="9" y="11" width="6" height="5" rx="1" /><path d="M10.2 11V9.6a1.8 1.8 0 0 1 3.6 0V11" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="trust-title" class="mt-2 font-display text-3xl font-medium sm:text-4xl">{t.title}</h2>
        <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-soft">{t.text}</p>
      </div>
    </div>
  </div>
</section>
