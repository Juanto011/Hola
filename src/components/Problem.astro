---
import { TEXT, type Lang } from '../config';
interface Props { lang: Lang }
const t = TEXT[Astro.props.lang].problem;
const icons = [
  // ojo / atención
  '<path d="M2.5 12s3.5-6.5 9.5-6.5S21.5 12 21.5 12s-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.8"/><path d="M4 20 20 4" stroke-linecap="round"/>',
  // costo
  '<circle cx="12" cy="12" r="8.5"/><path d="M14.8 9.2c-.5-1-1.6-1.6-2.8-1.6-1.6 0-2.8.9-2.8 2.1 0 2.9 5.8 1.6 5.8 4.5 0 1.2-1.3 2.2-3 2.2-1.3 0-2.5-.7-2.9-1.7M12 6v1.6M12 16.4V18" stroke-linecap="round"/>',
  // reloj
  '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2" stroke-linecap="round" stroke-linejoin="round"/>',
];
---
<section class="bg-sand-100 py-20 sm:py-28" aria-labelledby="problem-title">
  <div class="container-x">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="problem-title" class="h2 mt-4">{t.title}</h2>
    </div>
    <ul class="mt-12 grid gap-4 sm:grid-cols-3 sm:gap-6">
      {t.points.map((p, i) => (
        <li class="rounded-3xl border border-ink/5 bg-sand-50 p-7" data-reveal style={`--d:${i * 100}ms`}>
          <svg viewBox="0 0 24 24" class="h-8 w-8 text-clay" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" set:html={icons[i]} />
          <h3 class="mt-5 font-display text-2xl font-medium">{p.title}</h3>
          <p class="mt-2 leading-relaxed text-ink-soft">{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
