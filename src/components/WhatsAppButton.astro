---
// Botón flotante de WhatsApp (el número se cambia en src/config.ts)
import { TEXT, whatsappLink, type Lang } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<a
  href={whatsappLink(lang)}
  target="_blank"
  rel="noopener"
  data-track="Contact"
  aria-label={TEXT[lang].whatsapp.label}
  title={TEXT[lang].whatsapp.label}
  class="fixed right-4 bottom-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#1f8a4c] text-white shadow-xl shadow-black/20 transition hover:scale-105 sm:right-6 sm:bottom-6 sm:h-16 sm:w-16"
>
  <svg viewBox="0 0 24 24" class="h-7 w-7 sm:h-8 sm:w-8" fill="currentColor" aria-hidden="true"><path d="M12 2.5A9.4 9.4 0 0 0 3.9 16.6L2.6 21.4l4.9-1.3A9.4 9.4 0 1 0 12 2.5Zm0 17.2a7.8 7.8 0 0 1-4-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A7.8 7.8 0 1 1 12 19.7Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.2-.2-.5-.3Z" /></svg>
</a>
