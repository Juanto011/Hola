---
import BookButton from './BookButton.astro';
import { HERO_VIDEO, TEXT, type Lang } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = TEXT[lang].hero;
---
<section class="relative overflow-hidden">
  <!-- Fondo decorativo: luz cálida + hojas -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-40 -right-40 h-[36rem] w-[36rem] rounded-full bg-[radial-gradient(circle,rgba(208,138,100,0.22),transparent_65%)]"></div>
    <div class="absolute -bottom-48 -left-40 h-[34rem] w-[34rem] rounded-full bg-[radial-gradient(circle,rgba(143,165,138,0.28),transparent_65%)]"></div>
    <svg class="absolute -right-24 bottom-0 hidden h-[30rem] text-jungle/[0.06] lg:block" viewBox="0 0 200 300" fill="currentColor">
      <path d="M100 300C98 220 90 150 60 90 85 120 100 170 104 230 110 160 130 100 170 50 130 110 112 190 108 300Z" />
      <path d="M60 90C30 70 10 40 0 0c30 25 55 50 60 90Z" />
      <path d="M170 50c10-20 20-35 30-50-5 25-15 40-30 50Z" />
    </svg>
  </div>

  <div class="container-x grid items-center gap-12 pt-10 pb-16 sm:pt-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pt-20 lg:pb-24">
    <div data-reveal>
      <p class="eyebrow inline-flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-clay"></span>{t.eyebrow}
      </p>
      <h1 class="mt-5 font-display text-[2.6rem] leading-[1.02] font-medium tracking-tight text-balance sm:text-6xl lg:text-[4.6rem]" style="font-variation-settings:'opsz' 144">
        {t.title} <em class="font-normal text-jungle italic">{t.titleAccent}</em>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl">{t.subtitle}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <BookButton label={t.cta} class="w-full sm:w-auto" />
        <a href="#portfolio" class="btn-ghost w-full sm:w-auto">
          {t.secondary}
          <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M6.5 4.5v11l9-5.5-9-5.5Z" /></svg>
        </a>
      </div>
      <p class="mt-4 text-sm text-ink-soft">{t.note}</p>
    </div>

    <!-- Video destacado (se cambia en src/config.ts → HERO_VIDEO) -->
    <div class="relative mx-auto w-full max-w-[15rem] sm:max-w-[21rem]" data-reveal style="--d:150ms">
      <div class="absolute -inset-6 -z-10 rotate-3 rounded-[3rem] bg-sand-200/70"></div>
      <div class="relative aspect-[9/16] overflow-hidden rounded-[2.2rem] border-[6px] border-ink bg-jungle-900 shadow-2xl shadow-jungle-900/30">
        {HERO_VIDEO.src ? (
          <video
            class="h-full w-full object-cover"
            src={HERO_VIDEO.src}
            poster={HERO_VIDEO.poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={t.videoLabel}
          ></video>
        ) : (
          <img src={HERO_VIDEO.poster} alt={t.videoLabel} class="h-full w-full object-cover" width="540" height="960" fetchpriority="high" />
        )}
        <div class="pointer-events-none absolute top-3 left-1/2 h-5 w-20 -translate-x-1/2 rounded-full bg-ink"></div>
      </div>
      <span aria-hidden="true" class="absolute top-12 -left-6 rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-ink shadow-lg sm:-left-12">9:16 · Reel</span>
      <span aria-hidden="true" class="absolute bottom-16 -right-4 rounded-full bg-jungle px-3 py-1.5 text-xs font-semibold text-sand-50 shadow-lg sm:-right-10">{lang === 'en' ? 'Walkthrough · 16:9' : 'Recorrido · 16:9'}</span>
    </div>
  </div>
</section>
