---
import Logo from './Logo.astro';
import { SITE, TEXT, whatsappLink, type Lang } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = TEXT[lang].footer;
const year = new Date().getFullYear();
const phone = SITE.whatsappNumber.replace(/^506(\d{4})(\d{4})$/, '+506 $1 $2');
---
<footer class="bg-jungle-900 pt-16 pb-28 text-sand-200 sm:pb-16">
  <div class="container-x grid gap-10 sm:grid-cols-2">
    <div>
      <Logo light />
      <p class="mt-4 max-w-xs leading-relaxed">{t.tagline}</p>
    </div>
    <div class="sm:justify-self-end">
      <h2 class="text-xs font-semibold tracking-[0.18em] text-moss uppercase">{t.contact}</h2>
      <ul class="mt-4 space-y-3">
        <li>
          <a href={`mailto:${SITE.email}`} class="inline-flex items-center gap-3 hover:text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
            {SITE.email}
          </a>
        </li>
        <li>
          <a href={whatsappLink(lang)} target="_blank" rel="noopener" data-track="Contact" class="inline-flex items-center gap-3 hover:text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2.5A9.4 9.4 0 0 0 3.9 16.6L2.6 21.4l4.9-1.3A9.4 9.4 0 1 0 12 2.5Zm0 17.2a7.8 7.8 0 0 1-4-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A7.8 7.8 0 1 1 12 19.7Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-3.2-2.8c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.6 11.2 11.2 0 0 0 4.3 3.8c1.6.7 2.2.7 3 .6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.2-.2-.5-.3Z" /></svg>
            WhatsApp {phone}
          </a>
        </li>
        <li>
          <a href={SITE.instagramUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-3 hover:text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" /></svg>
            {SITE.instagramHandle}
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="container-x mt-12 border-t border-sand-50/10 pt-6 text-sm text-sand-300">
    © {year} {SITE.businessName}. {t.rights}
  </div>
</footer>
